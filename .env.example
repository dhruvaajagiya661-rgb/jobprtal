# =============================================================================
# PortAL environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# =============================================================================

# --- Application ---------------------------------------------------------
# DEBUG defaults to False when unset, so a deployment that forgets this fails
# closed rather than exposing tracebacks. Set True only for local development.
DEBUG=True

# Required whenever DEBUG=False -- the app refuses to start on the placeholder.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-change-this-in-production

ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=admin/

# Absolute public origin. Used for canonical links, sitemap.xml URLs and the
# links inside transactional email.
SITE_URL=http://localhost:8000

# --- Database ------------------------------------------------------------
# Leave DB_ENGINE unset for PostgreSQL, or use SQLite for local development:
#   DB_ENGINE=django.db.backends.sqlite3
DB_NAME=portal_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Redis (caching & websocket channel layer) ---------------------------
# Optional. Used only when set and DEBUG=False; otherwise in-memory is used.
REDIS_URL=redis://localhost:6379/0

# --- CORS / CSRF ---------------------------------------------------------
# Origins the SPA is served from. In production list your real domain(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Security (production) -----------------------------------------------
# HSTS and secure cookies switch on automatically when DEBUG=False.
# SECURE_SSL_REDIRECT is deliberately forced off in settings.py whenever
# DEBUG=False: behind Render/nginx TLS terminators Django cannot reliably see
# X-Forwarded-Proto, so enabling it makes Django 301 every HTTPS request back
# to the identical URL (ERR_TOO_MANY_REDIRECTS). HTTP -> HTTPS is enforced by
# the edge/proxy instead, so this value is ignored in production.
SECURE_SSL_REDIRECT=False

# --- Email ---------------------------------------------------------------
# Defaults to a console backend that prints mail to the server log. Point it at
# real SMTP before launch, or password resets and contact mail go nowhere.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@portal.com

# Inbox that the public /contact form delivers to.
CONTACT_EMAIL=support@portal.com

# --- Build ---------------------------------------------------------------
BUILD_VERSION=1.0.0

# --- Rate limiting (DRF throttling) --------------------------------------
# Format: "<count>/<period>", e.g. 1000/hour, 100/minute
THROTTLE_ANON_RATE=1000/hour
THROTTLE_USER_RATE=10000/hour
# Guards login/register against brute force -- keep this conservative.
THROTTLE_AUTH_RATE=200/hour
# Public contact form: unauthenticated and sends mail, so tighter still.
THROTTLE_CONTACT_RATE=10/hour

# --- JWT session length --------------------------------------------------
JWT_ACCESS_HOURS=12
JWT_REFRESH_DAYS=14
